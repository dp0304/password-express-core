{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 通行证",
  "mainBinaryName": "aipass-desktop",
  "version": "0.1.0",
  "identifier": "com.aipass.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/build-sidecars.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI 通行证",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "AI 通行证 — 让 AI 在授权范围内使用账号",
    "longDescription": "Password manager and access broker that lets AI agents use accounts within user-approved scopes without seeing raw credentials.",
    "copyright": "© AI Pass contributors. Licensed under the Apache License 2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aipass-mcp", "binaries/aipass-nm-host"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
